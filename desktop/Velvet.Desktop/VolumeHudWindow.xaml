<Window x:Class="Velvet.Desktop.VolumeHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velvet Volume" Width="286" Height="104" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource SansFont}">
    <Border x:Name="Card" CornerRadius="26" BorderThickness="1"
            BorderBrush="{DynamicResource AccentSoftBrush}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FA15101F" Offset="0" />
                <GradientStop Color="#FA08060F" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="6" Opacity="0.55" />
        </Border.Effect>

        <Grid Margin="20,15,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="VELVET" FontSize="8" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrightBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="PercentText" Text="82%" FontFamily="{StaticResource SerifFont}"
                           FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1" Height="7" Margin="0,11,0,9" VerticalAlignment="Center">
                <Border CornerRadius="3.5" Background="#16FFFFFF" />
                <Border x:Name="Fill" Width="0" HorizontalAlignment="Left" CornerRadius="3.5"
                        Background="{DynamicResource AccentGradient}">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="12"
                                          ShadowDepth="0" Opacity="0.85" />
                    </Border.Effect>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2" x:Name="DetailText" Text="SYSTEM VOLUME" FontSize="7.5"
                       FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" />
        </Grid>
    </Border>
</Window>
