<Window x:Class="Velvet.Desktop.VolumeHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velvet Volume" Width="320" Height="132" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource SansFont}">
    <Grid Margin="18">
        <Border x:Name="Card" CornerRadius="28" BorderThickness="1"
                BorderBrush="{DynamicResource AccentSoftBrush}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#CB171120" Offset="0" />
                    <GradientStop Color="#C90A0810" Offset="0.6" />
                    <GradientStop Color="#C607050C" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.55" />
            </Border.Effect>

            <Grid>
                <Border CornerRadius="27" Background="{DynamicResource IslandVeinBrush}"
                        Opacity="0.85" IsHitTestVisible="False" />

                <Rectangle Height="1.2" VerticalAlignment="Top" Margin="38,1,38,0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#B36FB8FF" Offset="0.32" />
                            <GradientStop Color="#D9FF6FB8" Offset="0.5" />
                            <GradientStop Color="#B36FB8FF" Offset="0.68" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Margin="20,12,20,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Border Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="SpeakerGlyph" Text="&#xE767;" FontFamily="{StaticResource IconFont}"
                                       FontSize="12" Foreground="{DynamicResource AccentBrightBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="VELVET" FontSize="8.5" FontWeight="SemiBold" Margin="9,0,0,0"
                                   Foreground="{DynamicResource AccentBrightBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="PercentText" Text="82" FontFamily="{StaticResource SerifFont}"
                                       FontSize="27" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="SuffixText" Text="%" FontSize="10" Margin="3,6,0,0"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid x:Name="TrackHost" Grid.Row="1" Height="14" Margin="0,6,0,6"
                          VerticalAlignment="Center">
                        <Border Height="7" CornerRadius="3.5" Background="#1CFFFFFF"
                                VerticalAlignment="Center" />
                        <Border x:Name="Fill" Width="0" Height="7" CornerRadius="3.5"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource AccentGradient}">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="12"
                                                  ShadowDepth="0" Opacity="0.9" />
                            </Border.Effect>
                        </Border>
                        <Ellipse Width="13" Height="13" HorizontalAlignment="Left"
                                 VerticalAlignment="Center" Margin="-6.5,0,0,0">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#FFF3EAF8" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="16"
                                                  ShadowDepth="0" Opacity="0.95" />
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,2,0">
                            <Rectangle Width="1" Height="4" Fill="#26FFFFFF" Margin="0,0,4,0" />
                            <Rectangle Width="1" Height="4" Fill="#26FFFFFF" Margin="0,0,4,0" />
                            <Rectangle Width="1" Height="4" Fill="#26FFFFFF" />
                        </StackPanel>
                    </Grid>

                    <DockPanel Grid.Row="2">
                        <TextBlock x:Name="DetailText" Text="SYSTEM VOLUME" FontSize="7.5"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="MEDIA" FontSize="7.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrightBrush}" />
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
